{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concierge Intake Document",
  "description": "Structured intake document produced by the Concierge workflow. Contains synthesized intent, constraints, and outcomes from the intake conversation.",
  "type": "object",
  "required": [
    "summary",
    "project_type",
    "outcome"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "document_type": {
      "type": "string",
      "description": "Document type identifier"
    },
    "project_name": {
      "type": "string",
      "description": "User-provided or derived project name"
    },
    "summary": {
      "type": "object",
      "description": "Synthesized project summary from intake conversation",
      "required": ["description", "user_statement"],
      "properties": {
        "description": {
          "type": "string",
          "description": "LLM-synthesized description of what the user wants to accomplish"
        },
        "user_statement": {
          "type": "string",
          "description": "The user's own statement of intent, preserved as-is"
        }
      }
    },
    "project_type": {
      "type": "object",
      "description": "Project type classification",
      "required": ["category"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["produce_output", "greenfield", "enhancement", "migration", "integration", "replacement", "unknown"],
          "description": "Project type category"
        },
        "rationale": {
          "type": "string",
          "description": "Explanation of why this category was chosen"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Confidence in the classification"
        }
      }
    },
    "constraints": {
      "type": "object",
      "description": "Known constraints from intake conversation",
      "properties": {
        "explicit": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Constraints explicitly stated by the user"
        },
        "inferred": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Constraints inferred from the user's description"
        },
        "none_stated": {
          "type": "boolean",
          "description": "Whether no constraints were mentioned"
        }
      }
    },
    "open_gaps": {
      "type": "object",
      "description": "Identified gaps and unknowns requiring resolution",
      "properties": {
        "questions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Questions that need answers before proceeding"
        },
        "missing_context": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Context that was not provided but may be needed"
        },
        "assumptions_made": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Assumptions made during intake that should be validated"
        }
      }
    },
    "outcome": {
      "type": "object",
      "description": "Intake gate outcome",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["qualified", "not_ready", "out_of_scope", "redirect"],
          "description": "Gate outcome status"
        },
        "rationale": {
          "type": "string",
          "description": "Why this outcome was determined"
        },
        "next_action": {
          "type": "string",
          "description": "Recommended next action based on outcome"
        }
      }
    }
  }
}
