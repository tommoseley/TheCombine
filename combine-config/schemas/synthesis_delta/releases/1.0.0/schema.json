{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thecombine.dev/schemas/synthesis_delta.v1.0.json",
  "type": "object",
  "title": "Synthesis Delta v1.0.0",
  "description": "Post-binder composition analysis output. Contains mechanical actions (restricted DSL with post-conditions) and judgment questions (operator-routed). Per ADR-070.",
  "required": [
    "project_id",
    "binder_document_count",
    "instance_a_finding_count",
    "instance_b_finding_count",
    "agreement_count",
    "actions",
    "questions"
  ],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "binder_document_count": { "type": "integer", "minimum": 0 },
    "instance_a_finding_count": { "type": "integer", "minimum": 0 },
    "instance_b_finding_count": { "type": "integer", "minimum": 0 },
    "agreement_count": { "type": "integer", "minimum": 0 },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_type", "targets", "rationale", "post_condition"],
        "properties": {
          "action_type": {
            "type": "string",
            "enum": ["MERGE_WS", "SPLIT_WS", "DEFER_COMPONENT", "REMOVE_WS", "NORMALIZE_BOUNDARY"]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Artifact IDs affected by this action. Must not be empty."
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "One sentence grounded in binder content"
          },
          "post_condition": {
            "type": "string",
            "minLength": 1,
            "description": "Machine-checkable assertion to verify after application"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "moderate"],
            "description": "high = both instances flagged, moderate = one instance flagged"
          },
          "normalize_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["scope_in", "scope_out", "allowed_paths", "dependencies", "upstream_dependencies"]
            },
            "description": "For NORMALIZE_BOUNDARY only: which fields may be adjusted. May NOT include objective, procedure, or definition_of_done."
          }
        },
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "lens", "severity", "artifacts", "question", "confidence"],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "lens": {
            "type": "string",
            "enum": ["platform_realism", "mvp_discipline", "authority_hygiene", "execution_readiness"]
          },
          "severity": {
            "type": "string",
            "enum": ["advisory", "should_fix", "blocking"]
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Affected document IDs"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "One sentence question for the operator"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "moderate"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
