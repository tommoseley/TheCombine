{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thecombine.dev/schemas/work_plan.v1.0.json",
  "type": "object",
  "title": "Work Plan v1.0.0",
  "description": "Final binder artifact with executive summary, decision log, and dependency context. Read-only deliverable per ADR-071.",
  "required": [
    "project_id",
    "assembled_at",
    "document_count",
    "referenced_documents",
    "executive_summary",
    "decision_log",
    "dependency_summary"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "assembled_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_count": {
      "type": "integer",
      "minimum": 0
    },
    "referenced_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "version", "display_id", "title", "doc_type_id"],
        "properties": {
          "document_id": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "display_id": { "type": "string" },
          "title": { "type": "string" },
          "doc_type_id": { "type": "string" },
          "group": { "type": "string" },
          "parent_display_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "executive_summary": {
      "type": "object",
      "required": ["project_name", "objective", "component_count", "work_package_count", "work_statement_count"],
      "properties": {
        "project_name": { "type": "string" },
        "objective": { "type": "string" },
        "component_count": { "type": "integer", "minimum": 0 },
        "work_package_count": { "type": "integer", "minimum": 0 },
        "work_statement_count": { "type": "integer", "minimum": 0 },
        "key_constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope_summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "decision_log": {
      "type": "array",
      "description": "Synthesis decisions with operator resolutions",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "headline", "decision"],
        "properties": {
          "finding_id": { "type": "string" },
          "severity": { "type": "string" },
          "headline": { "type": "string" },
          "decision": { "type": "string", "enum": ["accept", "reject"] },
          "note": { "type": ["string", "null"] },
          "decided_at": { "type": "string" },
          "finding_type": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "dependency_summary": {
      "type": "array",
      "description": "WP/WS dependency relationships",
      "items": {
        "type": "object",
        "required": ["from_display_id", "to_display_id"],
        "properties": {
          "from_display_id": { "type": "string" },
          "from_title": { "type": "string" },
          "to_display_id": { "type": "string" },
          "to_title": { "type": "string" },
          "dependency_type": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
